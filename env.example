# Fill out as necessary and rename the file to "env"

# Example: Apple Development: Your Name (4MOCKDC0DE)
APPLE_DEVELOPER_NAME=

# Example: 6A04FE22-1F5E-5e74-AE1D-7FEAC3EDA25E
IOS_DEVICE_ID=

# Example: /home/username/Android/Sdk/build-tools/34.0.0
ANDROID_SDK_LOCATION=

# Example: /home/username/Android/Sdk/ndk/29.0.14206865
ANDROID_NDK_LOCATION=

# Example: /home/username/Downloads/jdk-17.0.2
ANDROID_JAVA_HOME=
